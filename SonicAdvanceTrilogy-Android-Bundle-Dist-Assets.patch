+tasks.register('verifyBundledGameData') {
+    group = 'verification'
+    description = 'Comprueba que dist contiene ROMs y assets que se empaquetarán en el APK.'
+    doLast {
+        def romDir = new File(repositoryDist, 'main/roms')
+        def artDir = new File(repositoryDist, 'assets')
+        if (!romDir.isDirectory()) {
+            throw new GradleException("No existe ${romDir}. Las ROMs deben estar en dist/main/roms.")
+        }
+        if (!artDir.isDirectory()) {
+            throw new GradleException("No existe ${artDir}. Los recursos deben estar en dist/assets.")
+        }
+        // El launcher enumera ROMs en el nivel directo de main/roms, no recursivamente.
+        def roms = (romDir.listFiles() ?: []).findAll { f ->
+            f.isFile() && f.length() > 1024L && ['.gba', '.gbc', '.gb'].any { ext -> f.name.toLowerCase(Locale.ROOT).endsWith(ext) }
+        }
+        if (roms.isEmpty()) {
+            throw new GradleException("No se encontraron ROMs válidas (>1 KiB, .gba/.gbc/.gb) en ${romDir}; comprueba que Git LFS descargó los binarios reales si corresponde.")
+        }
+        def art = fileTree(artDir).files.findAll { f ->
+            f.isFile() && ['.png', '.jpg', '.jpeg', '.webp'].any { ext -> f.name.toLowerCase(Locale.ROOT).endsWith(ext) }
+        }
+        if (art.isEmpty()) {
+            throw new GradleException("No se encontraron imágenes en ${artDir}; los recursos deben estar incluidos en el repositorio.")
+        }
+        logger.lifecycle("Contenido del APK: ${roms.size()} ROM(s) y ${art.size()} imagen(es) encontradas en dist/.")
+    }
+}
+
+// Solo se copian las dos carpetas requeridas; no se empaqueta el resto de dist/.
+tasks.register('prepareBundledGameData', Sync) {
+    group = 'build'
+    description = 'Prepara las ROMs y los assets que se incluirán en el APK.'
+    dependsOn tasks.named('verifyBundledGameData')
+    into generatedBundledAssets
+    from(new File(repositoryDist, 'main/roms')) { into 'main/roms' }
+    from(new File(repositoryDist, 'assets')) { into 'assets' }
+}
+
+afterEvaluate {
+    tasks.named('preBuild').configure { dependsOn tasks.named('prepareBundledGameData') }
+}
